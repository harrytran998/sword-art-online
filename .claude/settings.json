{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(moon run *)",
      "Bash(bun test *)",
      "Bash(bun tsc --noEmit *)",
      "Bash(bun tsc --noEmit)",
      "Bash(oxlint .)",
      "Bash(oxlint *)",
      "Bash(oxfmt *)",
      "Bash(go-migrate *)",
      "Bash(docker compose *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh pr create:*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git commit:*)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(docker *)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(sudo *)",
      "Bash(curl *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/validate-imports.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/protect-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/format-on-save.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/warn-console-log.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-types.sh",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude needs your attention\" with title \"Sword Art Online\"'"
          }
        ]
      }
    ]
  }
}
