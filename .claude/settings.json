{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(chmod 777 *)",
      "Bash(dd *)",
      "Bash(git push --force *)",
      "Bash(git reset --force *)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(sudo *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/validate-imports.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/protect-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/format-on-save.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/warn-console-log.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-types.sh",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude needs your attention\" with title \"Sword Art Online\"'"
          }
        ]
      }
    ]
  }
}
