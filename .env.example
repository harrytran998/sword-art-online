# ============================================================
# Aincrad Online — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# ============================================================

# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aincrad
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# TimescaleDB (Analytics)
TIMESCALE_URL=postgresql://postgres:postgres@localhost:5433/aincrad_analytics

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:8080

# JWT
JWT_ISSUER=sword-art-online
JWT_AUDIENCE=sword-art-game
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Game Server
GAME_TICK_RATE=60
MAX_PLAYERS_PER_ZONE=200
MAX_PARTIES_PER_RAID=8

# WebSocket
WS_MAX_PAYLOAD_SIZE=65536
WS_HEARTBEAT_INTERVAL=30000
WS_MESSAGE_RATE_LIMIT=60

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# CORS
CORS_ORIGIN=http://localhost:5173
